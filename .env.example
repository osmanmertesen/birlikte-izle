# Bu dosyayı ".env" adıyla kopyala ve kendi değerlerini yaz.
# .env git'e GİRMEZ (.gitignore'da). Sonra:  node scripts/config.mjs
#
# Kendi relay sunucunun adresi (relay klasöründe "npx wrangler deploy" çıktısı, https yerine wss ile).
# Örnek: wss://birlikte-izle-relay.<senin-cloudflare-adin>.workers.dev
# Boş bırakırsan eklentide sunucu alanı boş gelir, panelden elle yazılır.
RELAY_URL=

# İsteğe bağlı: testlerin kullanacağı relay (boşsa yerel "npx wrangler dev": ws://127.0.0.1:8787)
TEST_RELAY_URL=

# İsteğe bağlı, sadece sır taraması için: kendi eklenti ID(ler)in, virgülle
# (chrome://extensions → Birlikte İzle kartı → "Kimlik"). Bu ID'ler hiçbir dosyaya girmemeli; tarama bunları arar.
BI_EXTENSION_IDS=
